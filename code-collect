#!/usr/bin/env python3
"""
Code Collect - Interactive file content aggregator for LLM context

Collect and format multiple code files for sharing with LLMs. 
Uses fuzzy finder for interactive selection, respects .gitignore patterns.

Usage:
    code-collect [directory] [options]

Arguments:
    directory           Directory to scan (default: current directory)

Options:
    -h, --help         Show this help message
    -v, --version      Show version information
    --changed          Auto-collect all git modified files (staged + unstaged)
    --staged           Auto-collect all git staged files
    --all              Auto-collect all files (respects .gitignore)

Examples:
    code-collect                    # Interactive selection from all files
    code-collect --changed          # Auto-collect all modified files
    code-collect --staged           # Auto-collect all staged files
    code-collect --all              # Auto-collect all files
    code-collect --all src/         # Auto-collect all files under src/
    code-collect /path/to/project   # Scan specific directory
    code-collect --changed ~/code   # Auto-collect modified files from ~/code

Features:
    • Interactive file selection with fuzzy search (fzf)
    • Respects .gitignore patterns automatically
    • Smart filtering of binary files and build directories
    • Proper syntax highlighting for 30+ languages
    • Automatic clipboard integration (macOS/Linux)
    • File size limits (1MB max per file)

Requirements:
    • Python 3.6+
    • fzf (brew install fzf)
"""

import os
import sys
import subprocess
import mimetypes
import fnmatch
from pathlib import Path

VERSION = "1.1.0"

# File patterns to ignore
IGNORE_PATTERNS = {
    '.git', '.svn', '.hg', '__pycache__', '.pytest_cache', 'node_modules',
    '.DS_Store', '.vscode', '.idea', 'dist', 'build', '.next', 'coverage',
    '*.pyc', '*.pyo', '*.pyd', '*.so', '*.dylib', '*.dll', '*.exe'
}

# File extensions to include (text files)
TEXT_EXTENSIONS = {
    '.py', '.js', '.ts', '.tsx', '.jsx', '.java', '.cpp', '.c', '.h', '.hpp',
    '.cs', '.php', '.rb', '.go', '.rs', '.swift', '.kt', '.scala', '.clj',
    '.html', '.css', '.scss', '.sass', '.less', '.xml', '.json', '.yaml', '.yml',
    '.md', '.txt', '.sh', '.bash', '.zsh', '.fish', '.ps1', '.bat', '.cmd',
    '.sql', '.r', '.m', '.mm', '.pl', '.lua', '.vim', '.el', '.lisp', '.hs',
    '.ml', '.fs', '.ex', '.exs', '.erl', '.dart', '.vue', '.svelte'
}

MAX_FILE_SIZE = 1024 * 1024  # 1MB limit

def is_text_file(filepath):
    """Check if file is likely a text file"""
    if filepath.suffix.lower() in TEXT_EXTENSIONS:
        return True
    
    mime_type, _ = mimetypes.guess_type(str(filepath))
    return mime_type and mime_type.startswith('text/')

def get_git_modified_files(base_path):
    """Get list of modified files from git"""
    try:
        # Get modified files (both staged and unstaged)
        result = subprocess.run([
            'git', 'diff', '--name-only', 'HEAD'
        ], cwd=base_path, capture_output=True, text=True, check=True)
        
        modified_files = []
        for line in result.stdout.strip().split('\n'):
            if line:  # Skip empty lines
                file_path = base_path / line
                if file_path.exists() and file_path.is_file():
                    modified_files.append(file_path)
        
        return modified_files
    
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []

def get_git_staged_files(base_path):
    """Get list of staged files from git"""
    try:
        result = subprocess.run([
            'git', 'diff', '--cached', '--name-only'
        ], cwd=base_path, capture_output=True, text=True, check=True)
        
        staged_files = []
        for line in result.stdout.strip().split('\n'):
            if line:  # Skip empty lines
                file_path = base_path / line
                if file_path.exists() and file_path.is_file():
                    staged_files.append(file_path)
        
        return staged_files
    
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []

def load_gitignore_patterns(base_path):
    """Load patterns from .gitignore file"""
    gitignore_path = base_path / '.gitignore'
    patterns = []
    
    if gitignore_path.exists():
        try:
            with open(gitignore_path, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    # Skip empty lines and comments
                    if line and not line.startswith('#'):
                        patterns.append(line)
        except Exception:
            pass  # Ignore errors reading .gitignore
    
    return patterns

def matches_gitignore_pattern(filepath, base_path, gitignore_patterns):
    """Check if file matches any .gitignore pattern"""
    relative_path = filepath.relative_to(base_path)
    path_str = str(relative_path)
    
    for pattern in gitignore_patterns:
        # Handle directory patterns (ending with /)
        if pattern.endswith('/'):
            pattern = pattern.rstrip('/')
            # Check if any parent directory matches
            for parent in relative_path.parents:
                if fnmatch.fnmatch(str(parent), pattern) or str(parent) == pattern:
                    return True
        else:
            # File or glob pattern
            if fnmatch.fnmatch(path_str, pattern) or fnmatch.fnmatch(filepath.name, pattern):
                return True
            # Also check if any parent directory matches (for nested patterns)
            if '/' in pattern:
                if fnmatch.fnmatch(path_str, pattern):
                    return True
    
    return False

def should_ignore(filepath, base_path, gitignore_patterns=None):
    """Check if file should be ignored"""
    relative_path = filepath.relative_to(base_path)
    
    # Check built-in ignore patterns
    for part in relative_path.parts:
        if part in IGNORE_PATTERNS or any(part.endswith(pattern.lstrip('*')) for pattern in IGNORE_PATTERNS if pattern.startswith('*')):
            return True
    
    # Check .gitignore patterns
    if gitignore_patterns and matches_gitignore_pattern(filepath, base_path, gitignore_patterns):
        return True
    
    return False

def get_files(directory):
    """Get all eligible files from directory"""
    base_path = Path(directory)
    gitignore_patterns = load_gitignore_patterns(base_path)
    files = []
    
    for filepath in base_path.rglob('*'):
        if (filepath.is_file() and 
            not should_ignore(filepath, base_path, gitignore_patterns) and 
            is_text_file(filepath) and
            filepath.stat().st_size <= MAX_FILE_SIZE):
            files.append(filepath)
    
    return sorted(files)

def select_files_with_fzf(files, base_path):
    """Use fzf for interactive file selection"""
    if not files:
        print("No eligible files found.")
        return []
    
    # Prepare file list with relative paths
    file_list = []
    for f in files:
        rel_path = f.relative_to(base_path)
        size = f.stat().st_size
        size_str = f"{size:,} bytes" if size < 1024 else f"{size/1024:.1f}KB"
        file_list.append(f"{rel_path} ({size_str})")
    
    try:
        # Run fzf with multi-select
        process = subprocess.run([
            'fzf', '--multi', '--height=50%', '--border', '--preview-window=right:50%',
            '--preview', f'head -50 {base_path}/{{1}}',
            '--prompt', 'Select files (TAB to multi-select, ENTER to confirm): '
        ], input='\n'.join(file_list), text=True, capture_output=True)
        
        if process.returncode != 0:
            return []
        
        # Parse selected files
        selected = []
        for line in process.stdout.strip().split('\n'):
            if line:
                # Extract filename (before the size info)
                filename = line.split(' (')[0]
                selected.append(base_path / filename)
        
        return selected
    
    except FileNotFoundError:
        print("Error: fzf not found. Install with: brew install fzf")
        return []

def get_language_from_extension(filepath):
    """Get language identifier for syntax highlighting"""
    ext = filepath.suffix.lower()
    lang_map = {
        '.py': 'python', '.js': 'javascript', '.ts': 'typescript', '.tsx': 'typescript',
        '.jsx': 'javascript', '.java': 'java', '.cpp': 'cpp', '.c': 'c', '.h': 'c',
        '.cs': 'csharp', '.php': 'php', '.rb': 'ruby', '.go': 'go', '.rs': 'rust',
        '.swift': 'swift', '.kt': 'kotlin', '.scala': 'scala', '.html': 'html',
        '.css': 'css', '.scss': 'scss', '.json': 'json', '.yaml': 'yaml', '.yml': 'yaml',
        '.md': 'markdown', '.sh': 'bash', '.sql': 'sql', '.xml': 'xml'
    }
    return lang_map.get(ext, '')

def format_file_content(filepath, base_path):
    """Format file content for LLM consumption"""
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        
        rel_path = filepath.relative_to(base_path)
        language = get_language_from_extension(filepath)
        
        return f"// {rel_path}\n```{language}\n{content}\n```\n"
    
    except Exception as e:
        return f"// {filepath.relative_to(base_path)} - Error reading file: {e}\n\n"

def copy_to_clipboard(text):
    """Copy text to clipboard using pbcopy (macOS)"""
    try:
        subprocess.run(['pbcopy'], input=text, text=True, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

def show_help():
    """Show help message"""
    print(__doc__)

def show_version():
    """Show version information"""
    print(f"Code Collect v{VERSION}")
    print("Interactive file content aggregator for LLM context")

def main():
    # Parse command line arguments
    directory = '.'
    git_mode = None
    
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg in ['-h', '--help']:
            show_help()
            sys.exit(0)
        elif arg in ['-v', '--version']:
            show_version()
            sys.exit(0)
        elif arg == '--changed':
            git_mode = 'changed'
        elif arg == '--staged':
            git_mode = 'staged'
        elif arg == '--all':
            git_mode = 'all'
        elif arg.startswith('-'):
            print(f"Unknown option: {arg}")
            print("Use --help for usage information")
            sys.exit(1)
        else:
            directory = arg
        i += 1
    
    base_path = Path(directory).resolve()
    
    if not base_path.exists():
        print(f"Error: Directory '{directory}' does not exist.")
        sys.exit(1)
    
    # Get files based on mode
    if git_mode == 'changed':
        print(f"Getting git modified files from {base_path}...")
        files = get_git_modified_files(base_path)
        if not files:
            print("No modified files found in git.")
            sys.exit(1)
        # Filter files through normal checks
        filtered_files = []
        gitignore_patterns = load_gitignore_patterns(base_path)
        for f in files:
            if (not should_ignore(f, base_path, gitignore_patterns) and 
                is_text_file(f) and
                f.stat().st_size <= MAX_FILE_SIZE):
                filtered_files.append(f)
        files = sorted(filtered_files)
        selected_files = files  # Auto-select all modified files
        
    elif git_mode == 'staged':
        print(f"Getting git staged files from {base_path}...")
        files = get_git_staged_files(base_path)
        if not files:
            print("No staged files found in git.")
            sys.exit(1)
        # Filter files through normal checks
        filtered_files = []
        gitignore_patterns = load_gitignore_patterns(base_path)
        for f in files:
            if (not should_ignore(f, base_path, gitignore_patterns) and 
                is_text_file(f) and
                f.stat().st_size <= MAX_FILE_SIZE):
                filtered_files.append(f)
        files = sorted(filtered_files)
        selected_files = files  # Auto-select all staged files
        
    elif git_mode == 'all':
        print(f"Collecting all files from {base_path}...")
        files = get_files(base_path)
        if not files:
            print("No eligible files found.")
            sys.exit(1)
        selected_files = files  # Auto-select all files
        
    else:
        print(f"Scanning {base_path}...")
        files = get_files(base_path)
        
        if not files:
            print("No eligible files found.")
            sys.exit(1)
        
        print(f"Found {len(files)} eligible files.")
        selected_files = select_files_with_fzf(files, base_path)
    
    if not selected_files:
        print("No files selected.")
        sys.exit(0)
    
    print(f"\nProcessing {len(selected_files)} files...")
    
    # Format all selected files
    formatted_content = []
    for filepath in selected_files:
        formatted_content.append(format_file_content(filepath, base_path))
    
    final_content = '\n'.join(formatted_content)
    
    # Copy to clipboard
    if copy_to_clipboard(final_content):
        print(f"✅ Copied {len(selected_files)} files to clipboard!")
        print("\nFiles included:")
        for f in selected_files:
            print(f"  • {f.relative_to(base_path)}")
    else:
        print("❌ Failed to copy to clipboard. Here's the content:\n")
        print(final_content)

if __name__ == '__main__':
    main()
